# Base URL of the API under test
API_BASE_URL=https://reqres.in

# API key for the ReqRes legacy /api/* endpoints (get one at app.reqres.in/api-keys)
API_KEY=your-api-key-here

# Network / retry tuning
REQUEST_TIMEOUT=30000
MAX_RETRIES=3

# Target environment (dev | staging | production)
TEST_ENV=dev

# Local mock server mode. Set to true to run the suite offline against the
# in-repo mock server (no API key needed, deterministic fixtures).
USE_MOCK=false

# URL of the mock server; override when running inside Docker Compose.
MOCK_BASE_URL=http://127.0.0.1:3001